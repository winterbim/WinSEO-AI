{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serpvera.dev/schemas/experiment-v1.schema.json",
  "title": "Experiment",
  "description": "A controlled change experiment with verification gates. Ported from NEXUS Search Intelligence v0.1.0.",
  "type": "object",
  "required": ["id", "project_id", "action_id", "hypothesis", "baseline_window", "measurement_window"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "action_id": { "type": "string", "format": "uuid" },
    "hypothesis": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "baseline_window": { "type": "string", "description": "ISO 8601 duration or date range for baseline measurement" },
    "measurement_window": { "type": "string", "description": "ISO 8601 duration or date range for post-change measurement" },
    "confounders": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known external factors that may affect measurement"
    },
    "control": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["none", "url_set", "time_period", "a_b"] },
        "description": { "type": "string" }
      }
    },
    "change": {
      "type": "object",
      "properties": {
        "target_type": { "type": "string" },
        "target_ref": { "type": "string" },
        "before_hash": { "type": "string" },
        "proposed_patch": { "type": "string" },
        "rollback_spec": { "type": "object" }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate_type": { "type": "string", "enum": ["recrawl_rule_absent", "gsc_window", "ai_search_rerun", "indexation_check", "custom"] },
          "spec": { "type": "object" },
          "expected_verdict": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "measuring", "verifying", "completed", "inconclusive", "rejected"]
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "INCONCLUSIVE", "BLOCKED"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}