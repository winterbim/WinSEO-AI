{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serpvera.dev/schemas/finding-v1.schema.json",
  "title": "Finding",
  "description": "A search-intelligence finding with evidence classification. Ported from NEXUS Search Intelligence v0.1.0.",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "rule_id",
    "rule_version",
    "title",
    "classification",
    "severity",
    "status",
    "confidence",
    "first_seen_at",
    "evidence_ids"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "rule_id": { "type": "string", "description": "e.g. TECH.CANONICAL.CONFLICT" },
    "rule_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 1 },
    "epistemic_class": {
      "type": "string",
      "enum": ["OBSERVED", "MEASURED", "DOCUMENTED", "INFERRED", "HYPOTHESIS", "UNKNOWN"]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "status": {
      "type": "string",
      "enum": ["open", "acknowledged", "in_progress", "resolved", "wont_fix"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "first_seen_at": { "type": "string", "format": "date-time" },
    "last_seen_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": "string", "format": "date-time" },
    "explanation": { "type": "string" },
    "recommendation": { "type": "string" },
    "scope": {
      "type": "object",
      "properties": {
        "url_ids": { "type": "array", "items": { "type": "string" } },
        "entity_ids": { "type": "array", "items": { "type": "string" } },
        "query_cluster_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verification_gate": {
      "type": "object",
      "properties": {
        "gate_type": { "type": "string" },
        "spec": { "type": "object" },
        "last_verdict": { "type": "string" }
      }
    },
    "affected_urls_count": { "type": "integer", "minimum": 0 },
    "source_class": {
      "type": "string",
      "enum": [
        "A1_FIRST_PARTY_CLIENT",
        "A2_OFFICIAL_ENGINE",
        "B_RESEARCH",
        "C_REPRO_VENDOR",
        "D_PRACTITIONER",
        "E_ANECDOTAL"
      ]
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
