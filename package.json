{
  "name": "serpvera",
  "version": "0.1.0",
  "private": true,
  "description": "WinSEO / SERPVERA — Search Intelligence SaaS, evidence-first",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=1 --env-mode=loose",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean",
    "db:migrate": "turbo db:migrate --env-mode=loose",
    "db:seed": "turbo db:seed --env-mode=loose"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.29"
    }
  }
}
